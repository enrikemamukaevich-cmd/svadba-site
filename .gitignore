# ============================================================================
# Что НЕ уходит в репозиторий.
#
# Репозиторий закрытый, но правило простое: секрет не должен попасть туда
# даже случайно. Один раз попав в историю коммитов, он оттуда не убирается
# обычными средствами — придётся менять сам секрет.
# ============================================================================

# --- зависимости -----------------------------------------------------------
node_modules/
package-lock.json

# --- секреты ---------------------------------------------------------------
# Памятка проекта: в ней лежит секрет панели владельца
CLAUDE.md
CLAUDE *.md
CLAUDE.local.md

# Данные тестового гостя: его secret подтверждает право удалять свои снимки
tests/guest.local.json

# Ключи, сертификаты, переменные среды — на случай, если кто-то положит их сюда
.env
.env.*
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
known_hosts
secrets.php
secrets.json

# Серверные обработчики появятся на этапах 6 и 7 и будут подключать ключи.
# Пока их нет, но правило пусть стоит заранее.
panel.php
yadisk.php

# --- отчёты и материалы проверок -------------------------------------------
# Скриншоты и исходники Playwright пересобираются командами npm run photos
# и npm test, в репозитории им делать нечего: только вес.
tests/shots/
tests/shots3/
tests/shots4/
tests/shots5/
tests/photos/
tests/photos-src/
playwright-report/
test-results/
*.webm
*.zip

# --- служебное -------------------------------------------------------------
.claude/settings.local.json
Thumbs.db
desktop.ini
.DS_Store
*.log
